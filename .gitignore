# ── Raw data ────────────────────────────────────────────────────────────
# Acoustic emissions and whole-slide histology live on Dropbox / lab
# storage, not in git. See data/README.md for how to obtain them.
data/acoustic/
data/histology/

# Large binary formats, wherever they appear
*.mat            # raw acoustic emission recordings (~500 MB each)
*.vsi            # Olympus whole-slide scans
*.ets            # Olympus tile stacks
*.fig            # MATLAB figures
*.tif
*.tiff
*.czi
*.nd2
*.lif

# Slide decks (lab figures / IF panels) — large, binary, not diffable
*.pptx

# ── Literature ──────────────────────────────────────────────────────────
# Published PDFs and in-preparation manuscripts are not redistributed here.
# docs/literature/README.md lists what belongs in this folder.
docs/literature/*.pdf

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# ── Derived outputs ─────────────────────────────────────────────────────
# Regenerate from raw data via the pipeline; keep the repo reproducible.
data/processed/
*.parquet
*.h5
*.hdf5
*.npz

# Per-mouse / per-section figures: local inspection only, not committed
# (aggregate figures in results/histology/slices/ and results/acoustic_eda/ are)
results/histology/figures/
results/histology/aligned/
results/histology/reconstruction/*.png
results/histology/reconstruction/*.gif

# ── OS / editor ─────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
.vscode/
.idea/

# ── Secrets ─────────────────────────────────────────────────────────────
.env
*.local

# Segmentation pilot environments (PyTorch / TensorFlow)
segmentation_alpha/.venv*/

# Correspondence and meetings with Dr. Todd: kept locally, never pushed
notes/meeting_*
notes/next-email-todd.md
notes/notes-for-next-time.txt
docs/lab/correspondence.md
